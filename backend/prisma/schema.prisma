generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Classroom {
  ClassID      String       @id
  ClassName    String
  ClassSubject String
  assignments  Assignment[]
  classmates   Classmate[]
}

model Student {
  StudentID    String       @id
  Name         String
  UserID       String?      @unique
  submissions  Submission[]
  user         User?        @relation(fields: [UserID], references: [id])
  classmates   Classmate[]
}

model Classmate {
  MateID      String    @id @default(cuid())
  StudentID   String
  ClassroomID String
  student     Student   @relation(fields: [StudentID], references: [StudentID])
  classroom   Classroom @relation(fields: [ClassroomID], references: [ClassID])

  @@unique([StudentID, ClassroomID])
}

model User {
  id            String       @id @default(cuid())
  username      String       @unique
  email         String       @unique
  password_hash String
  full_name     String
  role          String       @default("teacher")
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  submissions   Submission[]
  student       Student?
}

model Question {
  QuestID      String       @id
  prompt       String       @db.Text
  rubric       String       @db.Text
  submissions  Submission[]
  assignments  Assignment[]
}

model Assignment {
  AssignmentID String   @id @default(cuid())
  ClassID      String
  QuestID      String
  assigned_at  DateTime @default(now())
  classroom    Classroom @relation(fields: [ClassID], references: [ClassID])
  question     Question @relation(fields: [QuestID], references: [QuestID])

  @@unique([ClassID, QuestID])
}

model Submission {
  StudentID           String
  QuestID             String
  submission          String       @db.LongText
  score               Int?
  grade               Boolean  @default(false)
  draft_feedback      String?    @db.Text
  plagiarism_risk_score Float  @default(0.0)
  plagiarism_flagged  Boolean  @default(false)
  uploaded_at         DateTime @default(now())
  graded_at           DateTime?
  graded_by           String?

  @@id([StudentID, QuestID])
  student    Student   @relation(fields: [StudentID], references: [StudentID])
  question   Question  @relation(fields: [QuestID], references: [QuestID])
  gradedBy   User?     @relation(fields: [graded_by], references: [id])
}